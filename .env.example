# Supabase > Project Settings > API Keys sayfasından alınır.
# Bunlar tarayıcıya açık gider; service_role / secret anahtarı BURAYA KONMAZ.
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_KIMLIGI.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Yalnızca SUNUCUDA kullanılır. NEXT_PUBLIC_ ile BAŞLAMAZ, tarayıcıya gitmez.
OPENAI_API_KEY=sk-...
# İsteğe bağlı (varsayılan: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Gemini (öncelikli): aistudio.google.com > Get API key. Yalnızca sunucuda.
GEMINI_API_KEY=...
# İsteğe bağlı (varsayılan: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# İsteğe bağlı yedek model, ana model yoğun/yoksa denenir (varsayılan: gemini-3.6-flash)
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# DeepSeek (isteğe bağlı yedek): platform.deepseek.com. Yalnızca sunucuda.
DEEPSEEK_API_KEY=sk-...
# İsteğe bağlı (varsayılan: deepseek-flash)
# DEEPSEEK_MODEL=deepseek-flash

# Görsel üretimi aynı GEMINI_API_KEY ile çalışır. İsteğe bağlı (varsayılan: gemini-3.1-flash-lite-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Ücretsiz stok fotoğraf (pexels.com/api). Yalnızca sunucuda.
PEXELS_API_KEY=...
